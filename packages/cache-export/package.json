{
  "name": "@maxiaochao/pi-cache-export",
  "version": "0.1.0",
  "description": "Interactive cache usage dashboard export for Pi sessions.",
  "type": "module",
  "keywords": ["pi-package", "pi-extension", "cache", "dashboard"],
  "files": ["extensions", "src", "docs", "README.md", "TESTING.md", "CHANGELOG.md"],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chaochaoxiaochao/pi-toolkit.git",
    "directory": "packages/cache-export"
  },
  "pi": { "extensions": ["./extensions/cache-export.ts"] },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*"
  },
  "scripts": {
    "test": "node --experimental-strip-types tests/run-tests.mjs && node tests/e2e-browser.mjs",
    "load-test": "pi -ne -e ./extensions/cache-export.ts"
  },
  "publishConfig": { "access": "public" }
