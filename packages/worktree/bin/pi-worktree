#!/usr/bin/env bash
# pi-worktree: create, inspect, and clean up git worktrees.
#
# Usage:
#   pi-worktree create [--base <ref>] [--json] <name>  # create/reuse without launching pi
#   pi-worktree -l | --list                # list worktrees (main checkout marked "main checkout")
#   pi-worktree -i <name>                  # show base commit, ahead/behind, unique commits
#   pi-worktree -o | --out                 # cd back to the main checkout
#   pi-worktree -r [--force] <name> [<name> ...] # remove; force skips dirty/unmerged prompts
#   pi-worktree -p | --prune               # drop stale worktree registrations
set -euo pipefail

# Colors: only when stdout is a TTY and NO_COLOR is unset (no-color.org)
if [[ -t 1 && -z "${NO_COLOR:-}" ]]; then
  C_BOLD=$'\e[1m' C_DIM=$'\e[2m' C_RED=$'\e[31m' C_GREEN=$'\e[32m' C_YELLOW=$'\e[33m' C_CYAN=$'\e[36m' C_RESET=$'\e[0m'
else
  C_BOLD='' C_DIM='' C_RED='' C_GREEN='' C_YELLOW='' C_CYAN='' C_RESET=''
fi

ok()      { [[ "${QUIET:-0}" == 1 ]] || printf '%spi-worktree:%s %s\n' "$C_GREEN" "$C_RESET" "$*"; }
warn()    { printf '%s⚠️  %s%s\n' "$C_YELLOW" "$C_RESET" "$*"; }
die()     { printf '%spi-worktree: %s%s\n' "$C_RED" "$C_RESET" "$*" >&2; exit 1; }

require_repo() {
  git rev-parse --is-inside-work-tree >/dev/null 2>&1 || die "not inside a git repository"
}

main_checkout() {
  git rev-parse --path-format=absolute --git-common-dir | sed 's|/.git$||'
}

# Git <2.36 cannot emit NUL-delimited worktree paths. Its porcelain output
# leaves newlines unescaped, so read that version's registration files instead.
worktree_records() {
  local common root
  common=$(git rev-parse --path-format=absolute --git-common-dir) || return
  root=$(main_checkout) || return
  node - "$common" "$root" <<'NODE'
const { execFileSync } = require("node:child_process");
const { existsSync, readFileSync, readdirSync } = require("node:fs");
const { join, dirname } = require("node:path");
try {
  process.stdout.write(execFileSync("git", ["worktree", "list", "--porcelain", "-z"], { env: { ...process.env, LC_ALL: "C" }, stdio: ["ignore", "pipe", "pipe"] }));
} catch (error) {
  if (!error.stderr?.toString().includes("unknown switch `z'")) throw error;
  const [common, root] = process.argv.slice(2);
  const entries = [{ directory: common, path: root }];
  const linked = join(common, "worktrees");
  if (existsSync(linked)) for (const name of readdirSync(linked)) {
    const directory = join(linked, name);
    const gitdir = readFileSync(join(directory, "gitdir"), "utf8").replace(/\n$/, "");
    entries.push({ directory, path: dirname(gitdir) });
  }
  for (const entry of entries) {
    const head = readFileSync(join(entry.directory, "HEAD"), "utf8").trim();
    const fields = ["worktree " + entry.path];
    if (head.startsWith("ref: refs/heads/")) fields.push("branch " + head.slice(5));
    else if (/^[0-9a-f]{40,64}$/.test(head)) fields.push("HEAD " + head);
    if (existsSync(join(entry.directory, "locked"))) fields.push("locked");
    process.stdout.write(fields.join("\0") + "\0\0");
  }
}
NODE
}

# Resolve names against Git's registration, not a guessed directory. Managed
# directory names remain usable after a branch rename or detached checkout.
resolve_worktree() {
  local name="$1" expected field path="" branch="" head="" locked=0
  git check-ref-format --branch "$name" >/dev/null 2>&1 || die "invalid worktree/branch name: $name"
  expected="$(main_checkout)/.worktrees/$name"
  RESOLVED_DIR="" RESOLVED_BRANCH="" RESOLVED_HEAD="" RESOLVED_LOCKED=0
  while IFS= read -r -d '' field; do
    case "$field" in
      registration-error) die "cannot read worktree registrations" ;;
      "worktree "*) path=${field#worktree } ;;
      "branch "*) branch=${field#branch refs/heads/} ;;
      "HEAD "*) head=${field#HEAD } ;;
      locked|"locked "*) locked=1 ;;
      "")
        if [[ "$branch" == "$name" || "$path" == "$expected" ]]; then
          [[ -z "$RESOLVED_DIR" ]] || die "ambiguous worktree name: $name"
          RESOLVED_DIR="$path" RESOLVED_BRANCH="$branch" RESOLVED_HEAD="$head" RESOLVED_LOCKED="$locked"
        fi
        path="" branch="" head="" locked=0
        ;;
    esac
  done < <(worktree_records || printf 'registration-error\0')
}

verify_worktree() {
  local dir="$1" root common
  [[ ! -L "$dir" ]] || die "worktree must not be a symlink: $dir"
  root=$(git -C "$dir" rev-parse --show-toplevel) || die "invalid worktree: $dir"
  common=$(git -C "$dir" rev-parse --path-format=absolute --git-common-dir)
  [[ "$(cd "$dir" && pwd -P)" == "$(cd "$root" && pwd -P)" \
    && "$common" == "$(git rev-parse --path-format=absolute --git-common-dir)" ]] \
    || die "worktree registration does not match checkout: $dir"
}

validate_name() {
  local name="$1"
  [[ "$name" != */* ]] || die "worktree name must not contain '/': $name"
  git check-ref-format --branch "$name" >/dev/null 2>&1 || die "invalid worktree/branch name: $name"
}

# Best available base ref: current branch > HEAD (worktrees should branch
# from where you actually are; a stale origin/main must not win)
pick_base() {
  local cur; cur=$(git branch --show-current 2>/dev/null || true)
  if [[ -n "$cur" ]]; then
    echo "$cur"
  else
    echo HEAD
  fi
}

# Resolve base ref for a new worktree: explicit --base wins, else current branch.
resolve_base() {
  if [[ -n "${BASE_OVERRIDE:-}" ]]; then
    git rev-parse --verify --quiet "${BASE_OVERRIDE}^{commit}" >/dev/null \
      || die "base ref not found: $BASE_OVERRIDE"
    echo "$BASE_OVERRIDE"
  else
    pick_base
  fi
}

ensure_gitignore() {
  local root
  root=$(main_checkout)
  # The trailing slash is load-bearing: `.worktrees/` is a directory-only
  # pattern, and git check-ignore cannot match it against a path that does not
  # exist yet — so `.worktrees` would look unignored on every first run and the
  # rule would be appended again.
  if ! git -C "$root" check-ignore -q .worktrees/ 2>/dev/null; then
    printf '.worktrees/\n' >> "$root/.gitignore"
    ok "added .worktrees/ to .gitignore"
  fi
}

cmd_list() {
  require_repo
  local main_dir; main_dir=$(main_checkout)
  # Annotate the primary checkout and stale (prunable) entries.
  git worktree list --porcelain | awk -v main="$main_dir" \
    -v D="${C_DIM}" -v Y="${C_YELLOW}" -v C="${C_CYAN}" -v R="${C_RESET}" '
    /^worktree / { path=substr($0,10); next }
    /^HEAD /     { sha=substr($0,6); next }
    /^branch /   { b=substr($0,8); sub("refs/heads/","",b); next }
    /^detached/  { b="(detached)"; next }
    /^bare/      { b="(bare)"; next }
    /^prunable/  { stale=1; next }
    /^$/ {
      if (b=="") b="?"
      mark=(path==main) ? "  " D "(main checkout)" R : ""
      branch=(path==main) ? b : C b R
      hint=(stale) ? "  " Y "← stale: dir gone, run: pi-worktree prune" R : ""
      printf "%s  %s%s%s  %s%s%s\n", path, D, substr(sha,1,7), R, branch, mark, hint
      path=""; sha=""; b=""; stale=0
    }
  '
}

subcmd_prune() {
  require_repo
  git worktree prune -v
  ok "pruned stale worktree registrations"
}

cmd_out() {
  cd "$(main_checkout)" && exec "${SHELL:-/bin/bash}"
}

cmd_info() {
  require_repo
  [[ $# -eq 1 ]] || die "usage: pi-worktree -i <name>"
  resolve_worktree "$1"
  local dir="$RESOLVED_DIR"
  [[ -n "$dir" && -d "$dir" ]] || die "worktree not found: $1"
  verify_worktree "$dir"
  local branch; branch=$(git -C "$dir" branch --show-current)
  echo "worktree: $dir"
  if git -C "$dir" diff --quiet 2>/dev/null && git -C "$dir" diff --cached --quiet 2>/dev/null \
     && [[ -z "$(git -C "$dir" ls-files --others --exclude-standard)" ]]; then
    echo "status:   clean"
  else
    echo "status:   DIRTY"
    git -C "$dir" status --short | head -10
  fi
  echo "branch:   $branch @ $(git -C "$dir" rev-parse --short HEAD)"
  local base baseRef ahead behind
  base=$(git config --get "branch.$branch.base" 2>/dev/null || true)
  baseRef=$(git config --get "branch.$branch.baseRef" 2>/dev/null || true)
  if [[ -n "$base" ]]; then
    echo "based on: $baseRef @ $base"
    ahead=$(git rev-list --count "$base..$branch" 2>/dev/null || echo "?")
    echo "ahead:    $ahead commits since base"
  else
    echo "based on: (not recorded; run: git merge-base main $branch)"
  fi
  if git show-ref --verify --quiet refs/heads/main && [[ "$branch" != main ]]; then
    behind=$(git rev-list --count "$branch..main" 2>/dev/null || echo "?")
    echo "behind:   $behind commits vs main"$([[ "${behind:-0}" -gt 0 ]] && echo "  ← consider rebase")
  fi
  if [[ -n "$base" ]]; then
    echo "unique commits:"
    git log --oneline "$base..$branch" | head -5 || true
  fi
}

cmd_remove() {
  require_repo
  local name remove_force=0
  local names=()
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --force|-f) remove_force=1 ;;
      --) shift; names+=("$@"); break ;;
      -*) die "unknown remove option: $1" ;;
      *) names+=("$1") ;;
    esac
    shift
  done
  [[ ${#names[@]} -ge 1 ]] || die "usage: pi-worktree remove [--force] <name> [<name> ...]"
  for name in "${names[@]}"; do
    remove_one "$name" "$remove_force"
  done
}

remove_one() {
  resolve_worktree "$1"
  local dir="$RESOLVED_DIR" branch="$RESOLVED_BRANCH" merged=0 force="$2"
  local skip_confirmation="$2" merge_ref
  if [[ -n "$dir" ]]; then
    [[ "$dir" != "$(main_checkout)" ]] || die "cannot remove the main checkout"
    [[ "$dir" != "$(git rev-parse --show-toplevel)" ]] || die "cannot remove the current worktree"
    [[ "$RESOLVED_LOCKED" == 0 ]] || die "worktree is locked: $dir"
  elif git show-ref --verify --quiet "refs/heads/$1"; then
    branch="$1"
  else
    die "worktree not found: $1"
  fi
  merge_ref="${branch:-$RESOLVED_HEAD}"
  if [[ -n "$dir" && -d "$dir" ]]; then
    verify_worktree "$dir"
    # dirty worktree: removing discards modified/untracked files, which git
    # refuses to do without --force — so confirm the loss explicitly
    local dirty_status
    dirty_status=$(git -C "$dir" status --porcelain --untracked-files=all --ignore-submodules=none) \
      || die "cannot inspect worktree changes: $dir"
    if [[ -n "$dirty_status" ]]; then
      warn "worktree contains modified/untracked files that will be discarded:"
      printf '%s\n' "$dirty_status" | sed -n '1,10p'
      if [[ "$skip_confirmation" == 0 ]]; then
        read -rp "Discard and remove anyway? [y/N] " ans
        [[ "$ans" =~ ^[Yy]$ ]] || die "aborted"
      fi
      force=1
    fi
  fi
  # Use the same reference for the warning and the deletion decision.
  # branch -d alone checks upstream/HEAD, which can disagree with main.
  if [[ -n "$merge_ref" ]]; then
    if git merge-base --is-ancestor "$merge_ref" main 2>/dev/null; then
      merged=1
    else
      warn "checkout '${branch:-detached HEAD}' does not appear merged into 'main' (or no main branch exists)."
      if [[ "$skip_confirmation" == 0 ]]; then
        read -rp "Remove checkout and its branch (if any) anyway? [y/N] " ans
        [[ "$ans" =~ ^[Yy]$ ]] || die "aborted"
      fi
    fi
  elif [[ -n "$dir" ]]; then
    die "cannot determine checkout HEAD: $dir"
  fi
  if [[ -n "$dir" ]]; then
    local out
    if [[ "$force" == 1 ]]; then
      git worktree remove --force "$dir" && ok "removed: $dir (forced or discarded changes as confirmed)"
    elif out=$(git worktree remove "$dir" 2>&1); then
      ok "removed: $dir"
    elif [[ "$out" == *"submodules cannot be moved or removed"* ]]; then
      # git refuses to remove worktrees with initialized submodules unless
      # --force is used (--force only overrides the submodule check here; the
      # branch deletion below still asks before dropping unmerged commits)
      git worktree remove --force "$dir" && ok "removed: $dir (contained submodules)"
    else
      printf '%s\n' "$out" >&2
      die "failed to remove worktree: $dir"
    fi
  fi
  # Only remove the selected registration, including when its directory is
  # already gone. Never prune unrelated stale worktrees as a side effect.
  if [[ -n "$branch" ]] && git show-ref --verify --quiet "refs/heads/$branch"; then
    git branch -D -- "$branch"
    if [[ "$merged" == 1 ]]; then
      ok "deleted branch: $branch (merged into main)"
    else
      ok "deleted branch: $branch (not merged into main; $([[ "$skip_confirmation" == 1 ]] && echo forced || echo confirmed))"
    fi
  fi
}

create_wt() {
  local name="$1"
  require_repo
  validate_name "$name"

  # Re-entering the active branch is idempotent, including from a subdirectory.
  # New siblings live under the main checkout but branch from this checkout.
  local current_branch
  current_branch=$(git branch --show-current)
  if [[ "$current_branch" == "$name" && "$(git rev-parse --show-toplevel)" != "$(main_checkout)" ]]; then
    CREATE_STATUS="already-active"
    CREATE_DIR=$(cd "$(git rev-parse --show-toplevel)" && pwd -P)
    CREATE_BRANCH="$current_branch"
    CREATE_DIRTY=false
    if [[ -n "$(git status --porcelain)" ]]; then CREATE_DIRTY=true; fi
    return 0
  fi

  local root worktrees_dir dir
  root=$(main_checkout)
  worktrees_dir="$root/.worktrees"
  dir="$worktrees_dir/$name"
  [[ ! -L "$worktrees_dir" ]] || die "$worktrees_dir must be a real directory, not a symlink"
  [[ ! -L "$dir" ]] || die "$dir must not be a symlink"

  if [[ -d "$dir" ]]; then
    # Reuse: must be a registered worktree for this repo.
    # Skip the dirty-workspace prompt — the worktree already exists, nothing new to create.
    local registered_path
    registered_path=$(git worktree list --porcelain | sed -n 's/^worktree //p' | grep -Fx "$dir" || true)
    [[ -n "$registered_path" ]] || die "$dir exists but is not a registered git worktree"
    git -C "$dir" rev-parse --git-dir >/dev/null 2>&1 || die "$dir exists but is not a git worktree"
    [[ "$(git -C "$dir" rev-parse --path-format=absolute --git-common-dir)" == "$(git rev-parse --path-format=absolute --git-common-dir)" ]] \
      || die "$dir belongs to a different git repository"
    [[ "$(git -C "$dir" branch --show-current)" == "$name" ]] \
      || die "$dir is not checked out on expected branch '$name'"
    ensure_gitignore
    ok "reusing existing worktree $dir"
    CREATE_STATUS="reused"
  else
    local target_abs registered_path
    target_abs="$dir"
    registered_path=$(git worktree list --porcelain | sed -n 's/^worktree //p' | grep -Fx "$target_abs" || true)
    [[ -z "$registered_path" ]] \
      || die "stale worktree registration for $dir; run 'pi-worktree prune' first"
    ensure_gitignore
    mkdir -p "$worktrees_dir"
    # Reuse branch if it exists, else create it
    if git show-ref --verify --quiet "refs/heads/$name"; then
      if [[ "${QUIET:-0}" == 1 ]]; then
        git worktree add "$dir" "$name" >/dev/null
      else
        git worktree add "$dir" "$name"
      fi
      ok "checked out existing branch '$name'"
      CREATE_STATUS="attached"
      # record a best-effort base for -i display
      local mb; mb=$(git merge-base main "$name" 2>/dev/null || true)
      [[ -n "$mb" ]] && git config "branch.$name.base" "$(git rev-parse --short "$mb")" \
        && git config "branch.$name.baseRef" main
    else
      local base; base=$(resolve_base)
      if [[ "${QUIET:-0}" == 1 ]]; then
        git worktree add "$dir" -b "$name" "$base" >/dev/null
      else
        git worktree add "$dir" -b "$name" "$base"
      fi
      git config "branch.$name.base" "$(git rev-parse --short "$base")"
      git config "branch.$name.baseRef" "$base"
      ok "created branch '$name' from $base @ $(git rev-parse --short "$base")"
      CREATE_STATUS="created"
    fi
  fi

  CREATE_DIR=$(cd "$dir" && pwd -P)
  CREATE_BRANCH=$(git -C "$dir" branch --show-current)
  CREATE_DIRTY=false
  if [[ -n "$(git -C "$dir" status --porcelain)" ]]; then CREATE_DIRTY=true; fi
}

print_create_json() {
  PI_WORKTREE_STATUS="$CREATE_STATUS" \
  PI_WORKTREE_PATH="$CREATE_DIR" \
  PI_WORKTREE_BRANCH="$CREATE_BRANCH" \
  PI_WORKTREE_DIRTY="$CREATE_DIRTY" \
    node -e 'process.stdout.write(JSON.stringify({status:process.env.PI_WORKTREE_STATUS,path:process.env.PI_WORKTREE_PATH,branch:process.env.PI_WORKTREE_BRANCH,dirty:process.env.PI_WORKTREE_DIRTY==="true"})+"\n")'
}

cmd_create() {
  BASE_OVERRIDE=""
  local json=0
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --base)
        shift; [[ $# -ge 1 ]] || die "usage: pi-worktree create [--base <ref>] [--json] <name>"
        BASE_OVERRIDE="$1"; shift ;;
      --json) json=1; QUIET=1; shift ;;
      --*) die "unknown create option: $1" ;;
      *) break ;;
    esac
  done
  [[ $# -eq 1 ]] || die "usage: pi-worktree create [--base <ref>] [--json] <name>"
  create_wt "$1"
  if [[ "$json" == 1 ]]; then
    print_create_json
  else
    ok "$CREATE_STATUS worktree: $CREATE_DIR ($CREATE_BRANCH)"
  fi
}

case "${1:-}" in
  -l|--list|list|ls) shift; cmd_list "$@" ;;
  -i|--info|info) shift; cmd_info "$@" ;;
  -o|--out|out) shift; cmd_out "$@" ;;
  -r|--remove|rm|remove) shift; cmd_remove "$@" ;;
  -p|--prune|prune) shift; subcmd_prune ;;
  -h|--help|help) sed -n '2,10p' "$0" | sed 's/^# \{0,1\}//' ;;
  create) shift; cmd_create "$@" ;;
  "")  die "usage: pi-worktree create <name>  (or list / info / out / remove / prune)" ;;
  *)   die "unknown command: $1  (usage: pi-worktree create <name>)" ;;
esac
