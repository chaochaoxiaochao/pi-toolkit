{
  "name": "@maxiaochao/pi-codex-edit",
  "version": "0.1.7",
  "description": "Pi extension that exposes Codex-style apply_patch for GPT/Codex models with model-aware edit fallback.",
  "type": "module",
  "keywords": [
    "pi-package",
    "pi-extension",
    "codex",
    "gpt-5",
    "apply-patch"
  ],
  "files": [
    "extensions",
    "src",
    "tests",
    "benchmark",
    "docs",
    "config.json",
    "summary.md",
    "codex-edit-explainer.html",
    "README.md",
    "TESTING.md",
    "CHANGELOG.md",
    "package.json"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chaochaoxiaochao/pi-toolkit.git",
    "directory": "packages/codex-edit"
  },
  "pi": {
    "extensions": [
      "./extensions/codex-edit.ts"
    ]
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "scripts": {
    "test": "node tests/generate-test-report.mjs",
    "test:regression": "node --experimental-strip-types --test tests/package.test.mjs tests/parser.test.mjs tests/released-vs-local.test.mjs tests/benchmark.test.mjs",
    "test:compare-native": "pi -ne -e ./tests/native-vs-codex.ts",
    "test:compare-released": "node --experimental-strip-types --test tests/released-vs-local.test.mjs",
    "test:report": "node tests/generate-test-report.mjs",
    "load-test": "pi -ne -e ./extensions/codex-edit.ts"
  },
  "publishConfig": {
    "access": "public"
  }
}
