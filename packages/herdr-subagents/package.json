{
  "name": "@maxiaochao/pi-herdr-subagents",
  "version": "0.2.0",
  "description": "Run inspectable interactive Pi subagent batches through Herdr.",
  "type": "module",
  "keywords": [
    "pi-package",
    "pi-extension",
    "subagent"
  ],
  "files": [
    "extensions",
    "src",
    "agents",
    "tests",
    "docs",
    "README.md",
    "TESTING.md",
    "CHANGELOG.md",
    "package.json"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chaochaoxiaochao/pi-toolkit.git",
    "directory": "packages/herdr-subagents"
  },
  "pi": {
    "extensions": [
      "./extensions/herdr-subagents.ts"
    ]
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "scripts": {
    "test": "node --experimental-strip-types tests/run-tests.mjs",
    "load-test": "env -u PI_HERDR_SUBAGENTS_CHILD pi -ne -ns --no-session -e ./tests/extension-contract.ts && env -u PI_HERDR_SUBAGENTS_CHILD pi -ne -ns --no-session -e ./extensions/herdr-subagents.ts"
  },
  "publishConfig": {
    "access": "public"
  }
}
