{
  "name": "@maxiaochao/pi-todo",
  "version": "0.1.0",
  "description": "Branch-local execution-plan lifecycle and history extension for Pi.",
  "type": "module",
  "keywords": ["pi-package", "pi-extension", "todo"],
  "files": ["extensions", "src", "docs", "README.md", "TESTING.md", "CHANGELOG.md"],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chaochaoxiaochao/pi-toolkit.git",
    "directory": "packages/todo"
  },
  "pi": { "extensions": ["./extensions/todo.ts"] },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "scripts": {
    "test": "node --experimental-strip-types tests/todo-state.mjs && node --experimental-strip-types tests/todo-extension.mjs",
    "load-test": "pi -ne -e ./extensions/todo.ts"
  },
  "publishConfig": { "access": "public" }
}
