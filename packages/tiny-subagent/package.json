{
  "name": "@maxiaochao/pi-tiny-subagent",
  "version": "0.1.1",
  "description": "A tiny Pi subagent tool with package-local personas and detailed process errors.",
  "type": "module",
  "keywords": [
    "pi-package",
    "pi-extension",
    "subagent"
  ],
  "files": [
    "extensions",
    "src",
    "agents",
    "docs",
    "README.md",
    "TESTING.md",
    "CHANGELOG.md",
    "package.json"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chaochaoxiaochao/pi-toolkit.git",
    "directory": "packages/tiny-subagent"
  },
  "pi": {
    "extensions": [
      "./extensions/tiny-subagent.ts"
    ]
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "scripts": {
    "test": "node --experimental-strip-types tests/run-tests.mjs",
    "load-test": "pi -ne -ns --no-session -e ./extensions/tiny-subagent.ts"
  },
  "publishConfig": {
    "access": "public"
  }
}
