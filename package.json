{
  "name": "@maxiaochao/pi-toolkit",
  "version": "0.2.0",
  "description": "Personal pi coding agent toolkit: /todos, /btw, /cache_export extensions, browser automation, and bundled theme/skills.",
  "type": "module",
  "keywords": [
    "pi-package",
    "pi-extension"
  ],
  "files": [
    "extensions",
    "themes",
    "README.md",
    "CHANGELOG.md",
    "global/AGENTS.md",
    "scripts/install-agents.mjs",
    "skills"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chaochaoxiaochao/pi-toolkit.git"
  },
  "pi": {
    "extensions": [
      "./extensions/todo.ts",
      "./extensions/cache-export/index.ts",
      "./extensions/btw.ts"
    ],
    "skills": [
      "./skills"
    ],
    "themes": [
      "./themes"
    ]
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "dependencies": {
    "ws": "^8.19.0"
  },
  "scripts": {
    "test": "cd extensions/cache-export && node --experimental-strip-types tests/run-tests.mjs",
    "load-test": "pi -ne -e ./extensions/todo.ts && pi -ne -e ./extensions/cache-export/index.ts && pi -ne -e ./extensions/btw.ts",
    "eval:agents": "node evaluations/agents-md/run.mjs",
    "eval:agents:test": "node evaluations/agents-md/tests/run-tests.mjs",
    "postinstall": "node scripts/install-agents.mjs"
  },
  "publishConfig": {
    "access": "public"
  }
}
