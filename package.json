{
  "name": "@maxiaochao/pi-toolkit",
  "version": "0.9.3",
  "description": "Personal pi coding agent toolkit: /todos, /btw, /cache_export and apply_patch extensions, browser automation, and bundled theme/skills.",
  "type": "module",
  "keywords": [
    "pi-package",
    "pi-extension"
  ],
  "files": [
    "extensions",
    "packages/codex-edit/extensions",
    "packages/codex-edit/src",
    "packages/codex-edit/config.json",
    "themes",
    "bin",
    "README.md",
    "CHANGELOG.md",
    "global/AGENTS.md",
    "scripts/install-agents.mjs",
    "skills"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chaochaoxiaochao/pi-toolkit.git"
  },
  "pi": {
    "extensions": [
      "./extensions/todo.ts",
      "./extensions/cache-export/index.ts",
      "./extensions/btw.ts",
      "./extensions/codex-edit/index.ts"
    ],
    "skills": [
      "./skills"
    ],
    "themes": [
      "./themes"
    ]
  },
  "bin": {
    "pi-worktree": "bin/pi-worktree"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "dependencies": {
    "ws": "^8.19.0"
  },
  "scripts": {
    "test": "npm --prefix packages/codex-edit test && cd extensions/cache-export && node --experimental-strip-types tests/run-tests.mjs && node --experimental-strip-types ../tests/btw-history.mjs && node --experimental-strip-types ../tests/todo-state.mjs && node tests/e2e-browser.mjs",
    "load-test": "pi -ne -e ./extensions/todo.ts && pi -ne -e ./extensions/cache-export/index.ts && pi -ne -e ./extensions/btw.ts && pi -ne -e ./extensions/codex-edit/index.ts",
    "eval:agents": "node evaluations/agents-md/run.mjs",
    "eval:agents:test": "node evaluations/agents-md/tests/run-tests.mjs",
    "postinstall": "node scripts/install-agents.mjs"
  },
  "publishConfig": {
    "access": "public"
  }
}
