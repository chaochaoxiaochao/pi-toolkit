{
  "name": "@maxiaochao/pi-toolkit",
  "version": "0.10.3",
  "description": "Personal pi coding agent toolkit: execution plans, /btw, /cache_export and apply_patch extensions, browser automation, and bundled theme/skills.",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "keywords": [
    "pi-package",
    "pi-extension"
  ],
  "files": [
    "extensions",
    "packages/todo",
    "packages/cache-export",
    "packages/codex-edit",
    "packages/herdr-subagents",
    "packages/worktree",
    "themes",
    "README.md",
    "CHANGELOG.md",
    "global/AGENTS.md",
    "scripts/install-agents.mjs",
    "skills"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chaochaoxiaochao/pi-toolkit.git"
  },
  "pi": {
    "extensions": [
      "./packages/todo/extensions/todo.ts",
      "./packages/cache-export/extensions/cache-export.ts",
      "./extensions/btw/index.ts",
      "./packages/codex-edit/extensions/codex-edit.ts",
      "./packages/herdr-subagents/extensions/herdr-subagents.ts"
    ],
    "skills": [
      "./skills",
      "./packages/worktree/skills"
    ],
    "themes": [
      "./themes"
    ]
  },
  "bin": {
    "pi-worktree": "packages/worktree/bin/pi-worktree"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "dependencies": {
    "ws": "^8.19.0"
  },
  "scripts": {
    "test": "node tests/package-layout.mjs && npm --prefix packages/todo test && npm --prefix packages/cache-export test && npm --prefix packages/codex-edit test && npm --prefix packages/herdr-subagents test && npm --prefix packages/worktree test && node --experimental-strip-types extensions/btw/tests/history.mjs",
    "load-test": "pi -ne -e ./packages/todo/extensions/todo.ts && pi -ne -e ./packages/cache-export/extensions/cache-export.ts && pi -ne -e ./extensions/btw/index.ts && pi -ne -e ./packages/codex-edit/extensions/codex-edit.ts && pi -ne -e ./packages/herdr-subagents/extensions/herdr-subagents.ts",
    "eval:agents": "node evaluations/agents-md/run.mjs",
    "eval:agents:test": "node evaluations/agents-md/tests/run-tests.mjs",
    "postinstall": "node scripts/install-agents.mjs"
  },
  "publishConfig": {
    "access": "public"
  }
}
